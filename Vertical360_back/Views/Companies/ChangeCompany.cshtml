@using Vertical360_back.Entityes
@model List<Companies>

<h1>Selecciona una empresa</h1>

@if (Model.Count() == 0)
{
    <p>No hay empresas disponibles.</p>
}
else
{
    <form asp-action="ChangeCompany" method="post">
        <div class="list-group">
            @foreach (var company in Model)
            {
                <button type="submit" asp-route-id="@company.Id" class="list-group-item list-group-item-action">
                    @company.Name
                </button>
            }
        </div>
    </form>
}