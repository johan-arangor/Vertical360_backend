@using Vertical360_back.Entityes
@model CreateCompany
@{
    ViewData["Title"] = "Crear Compañia";
}

<h1>Crear Empresa</h1>

<div asp-asp-validation-summary="ModelOnly" class="text-danger"></div>

<from asp-action="Crear">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input type="text" asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Crear</button>
    <a class="btn btn-secondary" asp-action="Index" asp-asp-controller="Home">Cancelar</a>
</from>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}