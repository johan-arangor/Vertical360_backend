﻿@using Vertical360_back.Domain.Entityes
@using Vertical360_back.Entityes
@model AdminPermissionsDTO

<h1>Administrar permisos de @Model.Email</h1>

<form asp-action="Administrar">
    <input type="hidden" asp-for=UserId />
    <input type="hidden" asp-for=Email />

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <button type="button" class="btn btn-secondary"
            onclick="realizarSeleccion(true)">
        Seleccionar todos
    </button>
    <button type="button" class="btn btn-secondary"
            onclick="realizarSeleccion(false)">
        Deseleccionar todos
    </button>

    <ul>
        @for (var i = 0; i < Model.Permissions.Count; i++)
        {
            <li>
                <input id="Permissions[@i].loTiene"
                       name="Permissions[@i].loTiene"
                       value="true"
                       type="checkbox" @(Model.Permissions[i].Assigned ? "checked" : string.Empty)
                       @(Model.Permissions[i].Permission == Permissions.Null ? "disabled" : string.Empty) />
                <input type="hidden" value="@Model.Permissions[i].Permission" name="permisos[@i].permiso" />
                <span>@Model.Permissions[i].Description</span>
            </li>
        }
    </ul>
</form>

@section Scripts {
    <script>
        function realizarSeleccion(checked) {
            const checks = document.querySelectorAll("input[type=checkbox]");

            checks.forEach(v => {
                if (!v.disabled) {
                    v.checked = checked;
                }
            });
        }
    </script>
}